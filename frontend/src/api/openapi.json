    "/api/sessions/{year}/{round}/{session}/telemetry": {
      "get": {
        "summary": "Lap Telemetry",
        "operationId": "lap_telemetry_api_sessions__year___round___session__telemetry_get",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Year"
            }
          },
          {
            "name": "round",
            "in": "path",
            "required": true,
