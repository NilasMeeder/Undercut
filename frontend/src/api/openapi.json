    "/api/sessions/{year}/{round}/{session}/compare": {
      "get": {
        "summary": "Compare Laps",
        "operationId": "compare_laps_api_sessions__year___round___session__compare_get",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Year"
            }
          },
          {
            "name": "round",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Round"
            }
