          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "enum": ["FP1", "FP2", "FP3", "SQ", "SS", "S", "Q", "R"],
              "type": "string",
              "title": "Session"
            }
          },
          {
            "name": "laps",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Comma-separated DRV:lap, e.g. VER:17,NOR:fastest; first = reference",
              "title": "Laps"
            },
            "description": "Comma-separated DRV:lap, e.g. VER:17,NOR:fastest; first = reference"
          },
          {
            "name": "step",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 50,
              "minimum": 1,
              "description": "Grid spacing in metres",
              "default": 5.0,
              "title": "Step"
            },
            "description": "Grid spacing in metres"
          },
          {
            "name": "mini_sectors",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 25,
              "title": "Mini Sectors"
            }
          }
        ],
